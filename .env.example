# ambiente: development ou production (padrao: development)
NODE_ENV=development

# servidor
PORT=3000

# banco de dados
DB_HOST=localhost
DB_PORT=5432

# api de clima (gere uma chave de teste, nunca coloque a real aqui)
API_KEY=
WEATHER_API_URL=https://api.exemplo.com/v1

# integracao de pagamento
PAYMENT_URL=https://sandbox.pagamento.exemplo

# log: o caminho e montado a partir do NODE_ENV
LOG_PATH="./logs/${NODE_ENV:-development}.log"

# opcional: sobrescreve o nivel padrao do ambiente (debug, info, warn, error)
# LOG_LEVEL=
